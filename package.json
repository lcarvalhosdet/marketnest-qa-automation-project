{
  "name": "marketnest-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright tests for the MarketNest QA challenge",
  "scripts": {
    "test": "playwright test --project=unit --project=chromium",
    "test:unit": "playwright test --project=unit",
    "test:gdpr": "playwright test --project=chromium --project=account --grep @gdpr",
    "test:account": "playwright test --project=account",
    "test:cross-browser": "playwright test",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
